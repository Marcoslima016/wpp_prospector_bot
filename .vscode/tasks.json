{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar servidor (dev)",
      "detail": "Sobe o servidor Fastify em modo watch (npm run dev), recarregando a cada alteração em src/.",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev",
        "clear": true
      },
      "problemMatcher": {
        "owner": "wpp-prospector-bot-server",
        "source": "server",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^\\s*(.+?):(\\d+):(\\d+)\\s+-\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Restarting.*|.*node --watch.*",
          "endsPattern": ".*Servidor iniciado.*"
        }
      },
      "group": "build",
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Iniciar servidor (produção)",
      "detail": "Compila (tsc) e sobe o servidor a partir de dist/ (npm run build && npm start).",
      "type": "shell",
      "command": "npm run build && npm start",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "wpp-prospector-bot-server",
        "source": "server",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^\\s*(.+?):(\\d+):(\\d+)\\s+-\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*tsc.*|.*node .*dist/main\\.js.*",
          "endsPattern": ".*Servidor iniciado.*"
        }
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Limpar histórico de conversas",
      "detail": "Apaga os arquivos *.json/*.tmp de conversas por lead em CONVERSATIONS_DIR (padrão ./data/conversations). Mantém o diretório.",
      "type": "shell",
      "command": "npm run conversations:clear",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Iniciar painel (dev)",
      "detail": "Sobe o Vite dev server da SPA de gestão (wpp_prospector_bot_panel, npm run dev) em http://localhost:5173/admin/. Faz proxy de /admin/api para o servidor (:3000).",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/../wpp_prospector_bot_panel"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev",
        "clear": true
      },
      "problemMatcher": {
        "owner": "wpp-prospector-bot-panel",
        "source": "vite",
        "fileLocation": ["relative", "${workspaceFolder}/../wpp_prospector_bot_panel"],
        "pattern": {
          "regexp": "^\\s*(.+?):(\\d+):(\\d+)\\s+-\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(hmr update|page reload|restarting|rebuilding).*",
          "endsPattern": ".*(ready in|Local:\\s+https?://).*"
        }
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Iniciar servidor + painel (dev)",
      "detail": "Sobe o servidor Fastify (:3000) e o Vite dev server da SPA (:5173) em paralelo. Depois abra http://localhost:5173/admin/ e faça login com o valor de ADMIN_ACCESS_SECRET.",
      "dependsOn": ["Iniciar servidor (dev)", "Iniciar painel (dev)"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
