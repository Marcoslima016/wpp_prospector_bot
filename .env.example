# Copie para `.env` e preencha. `npm run dev`/`start` carregam `.env` se existir.

# --- WhatsApp Cloud API (Meta) ---
META_ACCESS_TOKEN=
META_APP_SECRET=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_WEBHOOK_VERIFY_TOKEN=
# Porta do servidor Fastify (default 3000)
# PORT=3000
# Registro append-only das janelas de conversa de 24 h faturáveis da Cloud API
# (métricas de consumo — fonte WhatsApp). "true"/"false"; desligado, o tratamento
# de status opera como sem a feature. (default true)
# WHATSAPP_COST_TRACKING_ENABLED=true
# País-base (ISO-3166-1 alpha-2) para estimar o custo de mensageria enquanto o
# país real do destinatário não é resolvido. (default BR)
# WHATSAPP_BILLING_COUNTRY=BR

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
# Só quando a API key é vinculada à identidade, não a um workspace
# ANTHROPIC_WORKSPACE_ID=

# --- Persistência ---
# Diretório dos arquivos JSON de conversa, 1 por lead (default ./data/conversations)
# CONVERSATIONS_DIR=./data/conversations
# Arquivo do armazenamento SQL embutido (node:sqlite). No modo WAL gera também
# `-wal`/`-shm` ao lado. NÃO substitui o repositório de conversas em arquivo.
# Requer Node 24.x (ou 22.13+/23.4+); em versões anteriores era necessária a
# flag `--experimental-sqlite`. (default ./data/app.db)
# DATABASE_PATH=./data/app.db
# Registro append-only do consumo de tokens de cada chamada ao LLM (métricas de
# consumo). "true"/"false"; desligado, o fluxo opera como sem a feature. (default true)
# LLM_USAGE_TRACKING_ENABLED=true

# --- API de gestão (/admin) ---
# NUNCA exponha /admin publicamente sem uma rede fechada (Tailscale / allowlist) na
# frente: o cookie de sessão é o mínimo, não uma fronteira de rede. `Secure` no cookie
# exige HTTPS (ok atrás de um proxy TLS).
# Liga/desliga toda a superfície /admin (API + estáticos). "true"/"false". (default true)
# ADMIN_ENABLED=true
# Segredo compartilhado trocado por um cookie de sessão em POST /admin/api/session.
# Obrigatório quando ADMIN_ENABLED=true.
ADMIN_ACCESS_SECRET=
# Segredo de servidor que assina o cookie de sessão (HMAC). Trocá-lo invalida todas as
# sessões. Obrigatório quando ADMIN_ENABLED=true.
ADMIN_SESSION_SECRET=
# Validade do cookie de sessão, em ms. (default 43200000 = 12h)
# ADMIN_SESSION_TTL_MS=43200000
# Diretório do build da SPA de gestão, relativo ao processo. Servido sob /admin só
# quando existir. (default ../wpp_prospector_bot_panel/dist)
# ADMIN_WEB_DIST_DIR=../wpp_prospector_bot_panel/dist
# Template aprovado usado como primeiro contato de prospecção — individual
# (POST /admin/api/leads/:leadPhone/prospect) e em lote (POST /admin/api/leads/prospect).
# OBRIGATÓRIO quando ADMIN_ENABLED=true — o boot falha sem ele.
PROSPECTING_TEMPLATE_NAME=abertura_lead_obras
# Idioma do template de primeiro contato (código aceito pela Cloud API). (default pt_BR)
PROSPECTING_TEMPLATE_LANG=pt_BR
# Nomes ordenados dos parâmetros do template, separados por vírgula. Dão a ordem
# posicional ao informar os parâmetros como objeto no corpo do disparo. (opcional)
# `abertura_lead_obras` não tem variáveis — deixe em branco.
# PROSPECTING_TEMPLATE_PARAM_KEYS=
