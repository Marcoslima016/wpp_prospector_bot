# Copie este arquivo para .env e preencha os valores. .env não é versionado.

# Identificador da sessão do WhatsApp (define a pasta de credenciais em .baileys_auth/<SESSION_ID>)
SESSION_ID=default

# Opcional: número de telefone padrão para o pareamento via código, usado quando
# você escolhe "2) Código de pareamento" no menu exibido ao iniciar o processo
# (o menu também deixa escolher "1) QR Code" a qualquer momento, sem precisar
# editar esta variável). Formato esperado pelo Baileys: apenas dígitos, com DDI,
# sem "+" nem espaços (ex.: 5511999999999). Se não estiver definida e você
# escolher pairing code no menu, o número é pedido interativamente.
# Ignorado quando a sessão já está registrada (reconexões não pedem um novo código).
WA_PAIRING_NUMBER=

# API key da Anthropic, usada pelo motor de raciocínio (ClaudeReasoningRepository)
ANTHROPIC_API_KEY=
